# OpenAI API 키
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
# (선택) 번역·메뉴용 모델, 기본 gpt-5.4
OPENAI_TRANSLATE_MODEL=

# 로컬 Postgres 또는 Render 등 외부 Postgres (External URL). 외부 DB는 SSL 자동 사용
# 표는 family_trip 스키마에 만들어져 기존 표와 섞이지 않음
DATABASE_URL=postgresql://localhost:5432/family_trip

# (선택) 가족 공용 비밀번호 — 비우면 비밀번호 없이 접속
APP_PASSCODE=

# (배포 시) Vercel Blob 토큰 — 비우면 사진은 로컬 uploads/ 폴더에 저장
BLOB_READ_WRITE_TOKEN=
